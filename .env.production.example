# ─────────────────────────────────────────────
# VoxIA production deploy — voxia.learnway.co
# Copy to `.env` next to docker-compose.prod.yml on the VPS and fill every
# REPLACE_ME. docker-compose.prod.yml already overrides DATABASE_URL,
# REDIS_URL, S3_ENDPOINT and JAVASCRIPT_EXECUTOR_URL to point at the
# containers on voxia-network — do not set those here, they're ignored.
# ─────────────────────────────────────────────

NEXT_PUBLIC_EDITION=community
PLATFORM_ADMIN_EMAIL=REPLACE_ME@example.com

# openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_ME
BETTER_AUTH_URL=https://voxia.learnway.co
NEXT_PUBLIC_BUILDER_URL=https://voxia.learnway.co
FORCE_PUBLIC_HTTPS=true

# openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_ME

# Postgres — read by docker-compose.prod.yml itself (project-level .env), and
# used to build DATABASE_URL for builder/worker automatically.
POSTGRES_DB=voxia
POSTGRES_USER=voxia
POSTGRES_PASSWORD=REPLACE_ME

# RustFS (S3-compatible storage) credentials.
RUSTFS_ACCESS_KEY=voxia
RUSTFS_SECRET_KEY=REPLACE_ME
S3_ACCESS_KEY_ID=voxia
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET=voxia
S3_REGION=us-west-2
# Must match RUSTFS_SECRET_KEY / S3_SECRET_ACCESS_KEY above.

# openssl rand -hex 32 (min 32 chars) — shared secret between worker and
# javascript-executor, both internal-only containers.
JAVASCRIPT_EXECUTOR_TOKEN=REPLACE_ME

# openssl rand -base64 32 — shared secret between builder and realtime.
REALTIME_BROADCAST_SECRET=REPLACE_ME

# SMTP for transactional email (invites, password reset, etc.). Point this at
# a real SMTP relay for production — MailHog is dev-only.
SMTP_SERVER=smtp://REPLACE_ME:REPLACE_ME@REPLACE_ME:587
SMTP_FROM=no-reply@learnway.co

SCHEDULER_BUCKET_RANGE=0-255
LOG_LEVEL=info
LOG_DEBUG=false

# ─────────────────────────────────────────────
# First boot only: run migrations once, then flip back to false and
# `docker compose -f docker-compose.prod.yml up -d builder` to restart
# without re-running migrate on every deploy.
# ─────────────────────────────────────────────
RUN_DB_MIGRATE=true

# ─────────────────────────────────────────────
# Docker network nginx-proxy-manager is on (confirmed via `docker inspect
# nginx-proxy-manager`) — lets NPM reach `builder`/`realtime` by name.
# ─────────────────────────────────────────────
NGINX_EXTERNAL_NETWORK=red-de-sitios_red-web
